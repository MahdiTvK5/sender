# نمونه فایل تنظیمات. یک کپی به نام `.env` بسازید:  cp .env.example .env

# آدرس عمومی سایت که برای ساخت لینک اشتراک استفاده می‌شود.
# اگر خالی بماند، از روی هدرهای درخواست (host/proto) محاسبه می‌شود.
BASE_URL=https://your-domain.com

# مسیر فایل دیتابیس SQLite (پیش‌فرض: ./data/configs.db)
DATABASE_PATH=./data/configs.db

# مدت اعتبار هر لینک به ساعت (پیش‌فرض ۲۴)
TTL_HOURS=24

# میزبان و پورت اجرای سرور
HOST=0.0.0.0
PORT=8000
