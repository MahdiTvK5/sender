# ------------------------------------------------------------------
# نمونه فایل تنظیمات محیطی. یک کپی به نام `.env` بسازید و مقادیر را پر کنید.
# cp .env.example .env
# ------------------------------------------------------------------

# آدرس عمومی سایت که برای ساخت لینک اشتراک استفاده می‌شود.
# چون با پیشوند NEXT_PUBLIC_ است، باید هنگام `npm run build` هم تنظیم باشد.
# اگر خالی بماند، از روی هدرهای درخواست (host/proto) محاسبه می‌شود.
NEXT_PUBLIC_BASE_URL=https://your-domain.com

# مسیر فایل دیتابیس SQLite. برای پایداری داده‌ها یک مسیر ثابت خارج از پروژه بدهید.
# پیش‌فرض: ./data/configs.db
DATABASE_PATH=/var/lib/config-share/configs.db

# پورت اجرای سرور (اختیاری، پیش‌فرض 3000).
PORT=3000
